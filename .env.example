# Copy this file to ".env" (same folder) before running the app, and
# fill in your own values. ".env" is never uploaded to GitHub -- it's
# where your real passwords live.

# --- Database (used only inside Docker, between the two containers) ---
POSTGRES_DB=tenant_app
POSTGRES_USER=tenant_app
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://tenant_app:change-this-db-password@db:5432/tenant_app

# --- App security ---
# Any long random text. Used internally by Flask to keep logins secure.
SECRET_KEY=change-this-to-a-long-random-string

# Encrypts SSNs at rest. Generate a real one before storing any real
# applicant data -- see "Encryption key" in README.md for the exact
# command. Do NOT reuse the example below for anything but local testing.
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtZmFsbGJhY2sta2V5MzI=

# --- First admin login ---
# Created automatically the first time the app starts, if no admin
# exists yet. Change the password here before your first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme123

# --- Email notifications (optional, off by default) ---
# See "Setting up tenant emails" in README.md.
EMAIL_ENABLED=false
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Housing Applications

# Runs the inspection SLA check (reminders/escalation) on a real hourly
# clock in the background. Leave this on -- only turn it off if you're
# running a one-off script that imports the app and don't want a
# background thread started.
ENABLE_SCHEDULER=true
